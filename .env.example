# Copy this file to .env.local and fill in your own values.
# .env.local holds your secret key: never commit it or share it.
# After changing .env.local, restart `npm run dev`.

# Required. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. The Gemini model used for every AI step.
# If omitted, the app uses gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# Optional. How many times a temporary Gemini failure is retried (default 2).
GEMINI_RETRY_ATTEMPTS=2

# Optional. Comma-separated backup models. When GEMINI_MODEL is out of quota or
# unavailable, every AI step (analysis, generation, checks) tries these in order.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
